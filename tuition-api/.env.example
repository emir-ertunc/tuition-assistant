# copy this file as .env and fill the values

# postgres connection (local or azure)
# local:  postgresql+psycopg://postgres:<password>@localhost:5432/tuition_db
# azure:  postgresql+psycopg://<user>:<password>@<server>.postgres.database.azure.com:5432/tuition_db?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/tuition_db

# jwt settings
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=tuition-api
JWT_AUDIENCE=tuition-clients
