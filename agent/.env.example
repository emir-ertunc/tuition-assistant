# copy this file as .env and fill the values

# key from google ai studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# gemini flash model, has a free tier on the gemini developer api
# alternatives: gemini-3.8-flash (newer, was often overloaded with 503), gemini-3.5-flash-lite (cheaper)
GEMINI_MODEL=gemini-3.5-flash-lite

# all rest calls go through the gateway
# cloud: https://<apim-name>.azure-api.net/api/v1   local api without gateway: http://localhost:8000/api/v1
GATEWAY_BASE_URL=https://<apim-name>.azure-api.net/api/v1
# Ocp-Apim-Subscription-Key header, leave empty for the local api
GATEWAY_SUBSCRIPTION_KEY=

# policy search server (streamable http), not behind the gateway
MCP_SERVER_URL=http://localhost:8001/mcp

# optional
# AGENT_MAX_TOOL_ROUNDS=5
# AGENT_LOG_DIR=logs
