# copy this file as .env and fill the values

MCP_HOST=127.0.0.1
MCP_PORT=8001
POLICY_FILE=data/University_Tuition_Policies.md

# public host name(s) of the server, comma separated (needed on Azure, e.g. my-app.azurewebsites.net)
MCP_ALLOWED_HOSTS=
# only needed if a browser based client calls the server
MCP_ALLOWED_ORIGINS=
MCP_STATELESS=true
